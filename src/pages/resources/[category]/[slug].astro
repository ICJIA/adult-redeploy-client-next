---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourceDetailShell from '../../../components/ResourceDetailShell.astro';
import { resEnumToSlug } from '../../../lib/resources';
import { RES_DETAIL_SIG } from '../../../lib/live/render/resource-detail';

type Resource = CollectionEntry<'resources'>['data'];

export async function getStaticPaths() {
  const items = await getCollection('resources');
  return items
    .filter((r) => resEnumToSlug[r.data.category])
    .map((r) => ({
      params: { category: resEnumToSlug[r.data.category], slug: r.data.slug },
      props: { item: r.data },
    }));
}
const { item } = Astro.props as { item: Resource };
// Live island: refetch by slug on load + tab focus; swap only when updatedAt changed.
const xData = `liveEntry({ surface: 'resourceDetail', slug: ${JSON.stringify(item.slug)}, sig: ${JSON.stringify(RES_DETAIL_SIG(item))} })`;
---
<BaseLayout title={item.title} description={item.summary ?? undefined}>
  <div x-data={xData}>
    <ResourceDetailShell item={item} />
  </div>
</BaseLayout>
