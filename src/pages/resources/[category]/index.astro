---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import ListingTable from '../../../components/alpine/ListingTable.astro';
import { RESOURCE_CATEGORIES, type ResourceCategory } from '../../../lib/resources';
import { resourcesCategoryRows, RES_CAT_SIG_KEYS } from '../../../lib/live/render/listing-rows';
import { stableSignature } from '../../../lib/live/behavior/signature';

type Resource = CollectionEntry<'resources'>['data'];

export async function getStaticPaths() {
  return RESOURCE_CATEGORIES.map((c) => ({
    params: { category: c.slug },
    props: { category: c },
  }));
}
const { category } = Astro.props as { category: ResourceCategory };
const entries = await getCollection('resources');
const base = import.meta.env.BASE_URL || '/adultredeploy';
const ctx = { endpoint: '', basePath: base };
// Shared row builder drives both the static rows and the live swap; the
// category reaches the island through params.
const cat = { enum: category.enum, slug: category.slug };
const rows = resourcesCategoryRows(entries.map((e): Resource => e.data), ctx, cat);
const live = { surface: 'resourcesCategory', sig: stableSignature(rows, RES_CAT_SIG_KEYS), params: cat };
---
<BaseLayout title={category.title}
            description={`${category.title} from Adult Redeploy Illinois — ${rows.length} publication${rows.length === 1 ? '' : 's'}.`}>
  <div class="max-w-6xl mx-auto px-6 py-10">
    <Breadcrumb items={[
      { label: 'Home',      href: `${base}/` },
      { label: 'Resources', href: `${base}/resources` },
      { label: category.short },
    ]} />
    <h1 class="text-page-title mt-4">{category.title}</h1>
    <div class="mt-8">
      <ListingTable ariaLabel={category.slug}
        columns={[
          { key: 'title',           label: 'Title' },
          { key: 'publicationDate', label: 'Published', format: 'date' },
        ]}
        rows={rows}
        live={live}
      />
    </div>
  </div>
</BaseLayout>
