---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Markdown from '../../components/Markdown.astro';
import { renderMarkdown } from '../../lib/markdown';
import { getCmsImageByPath } from '../../lib/cms-image';
import { selectBoard, renderBoardList, BIO_LIST_SIG_KEYS } from '../../lib/live/render/bio-list';
import { stableSignature } from '../../lib/live/behavior/signature';
import { PAGE_DETAIL_SIG } from '../../lib/live/render/page-detail';

type Bio = CollectionEntry<'biographies'>['data'];

const page = await getEntry('pages', 'about/oversight');
const base = import.meta.env.BASE_URL || '/adultredeploy';
const ctx = { endpoint: '', basePath: base };
const entries = await getCollection('biographies');
// The CMS category for Oversight Board members is 'board' (staff is 'staff');
// selectBoard filters + alphabetizes. The same select + render fn drive the live
// island (surface `boardList`), so static and live markup can't diverge.
const board = selectBoard(entries.map((e): Bio => e.data));
const listHtml = renderBoardList(board, ctx, { image: getCmsImageByPath, markdown: renderMarkdown });
// The CMS intro paragraph (pages: about/oversight) refreshes through the generic pageDetail surface.
const introXData = `liveEntry({ surface: 'pageDetail', slug: 'about/oversight', sig: ${JSON.stringify(PAGE_DETAIL_SIG(page?.data))} })`;
const listXData = `liveEntry({ surface: 'boardList', slug: 'board', sig: ${JSON.stringify(stableSignature(board, BIO_LIST_SIG_KEYS))} })`;
---
<BaseLayout title="Oversight Board"
            description="The Adult Redeploy Illinois Oversight Board guides program policy and reviews local-site funding decisions.">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <Breadcrumb items={[
      { label: 'Home',  href: `${base}/` },
      { label: 'About', href: `${base}/about` },
      { label: 'Oversight Board' },
    ]} />
    <h1 class="text-page-title mt-4">Oversight Board</h1>
    {page && (
      <div x-data={introXData}>
        <Markdown content={page.data.content} class="mt-4" dataLive="body" />
      </div>
    )}
    <div x-data={listXData}>
      <ul class="mt-8 grid gap-6 md:grid-cols-2" data-live="list" set:html={listHtml}></ul>
    </div>
  </div>
</BaseLayout>
