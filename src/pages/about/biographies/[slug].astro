---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BioDetailShell from '../../../components/BioDetailShell.astro';
import { fullName, stripTags } from '../../../lib/live/render/bio-list';
import { BIO_DETAIL_SIG } from '../../../lib/live/render/bio-detail';

type Bio = CollectionEntry<'biographies'>['data'];

export async function getStaticPaths() {
  const items = await getCollection('biographies');
  return items.map((b) => ({
    params: { slug: b.data.slug },
    props: { item: b.data },
  }));
}
const { item } = Astro.props as { item: Bio };
const name = fullName(item);
const role = item.category === 'staff' ? 'staff' : 'Oversight Board member';

// Plain-text meta description (CMS titles can carry legacy <span> markup).
const description = [
  `${name}, ${role} — Adult Redeploy Illinois.`,
  stripTags(item.title) || null,
  stripTags(item.membership) || null,
].filter(Boolean).join(' ');

// Live island: refetch by slug on load + tab focus; swap only when updatedAt changed.
const xData = `liveEntry({ surface: 'bioDetail', slug: ${JSON.stringify(item.slug)}, sig: ${JSON.stringify(BIO_DETAIL_SIG(item))} })`;
---
<BaseLayout title={name} description={description}>
  <div x-data={xData}>
    <BioDetailShell item={item} />
  </div>
</BaseLayout>
