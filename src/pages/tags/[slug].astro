---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { tagPageRows, renderTagSections, TAG_SIG_KEYS } from '../../lib/live/render/tag-page';
import { stableSignature } from '../../lib/live/behavior/signature';

type Tag = CollectionEntry<'tags'>['data'];

export async function getStaticPaths() {
  const tagEntries = await getCollection('tags');
  return tagEntries.map((t) => ({
    params: { slug: t.data.slug },
    props: { tag: t.data },
  }));
}
const { tag } = Astro.props as { tag: Tag };
const base = import.meta.env.BASE_URL || '/adultredeploy';
const ctx = { endpoint: '', basePath: base };

// The same builder + renderer drive the live island (surface tagPage), so
// static and live markup can't diverge; the baseline signature skips no-op
// refreshes.
const rows = tagPageRows({
  posts: (await getCollection('news')).map((e) => e.data),
  meetings: (await getCollection('meetings')).map((e) => e.data),
  resources: (await getCollection('resources')).map((e) => e.data),
}, ctx, tag.slug);
const xData = `liveCollection({ surface: 'tagPage', sig: ${JSON.stringify(stableSignature(rows, TAG_SIG_KEYS))}, params: { tag: ${JSON.stringify(tag.slug)} } })`;
---
<BaseLayout title={`Tag: ${tag.name}`}
            description={`News, meetings, and resources tagged "${tag.name}" on Adult Redeploy Illinois.`}>
  <div class="max-w-4xl mx-auto px-6 py-10">
    <Breadcrumb items={[
      { label: 'Home', href: `${base}/` },
      { label: `Tag: ${tag.name}` },
    ]} />
    <h1 class="text-page-title mt-4">{tag.name}</h1>
    <div x-data={xData}>
      <div x-ref="region" set:html={renderTagSections(rows)}></div>
    </div>
  </div>
</BaseLayout>
